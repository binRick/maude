# Saved Docker images (multi-GB) — never store as plain blobs.
assets/images/*.tar    filter=lfs diff=lfs merge=lfs -text

# Ollama model blobs (multi-GB). Manifests/configs are tiny JSON and are fine
# as regular files — only the blob payloads need LFS.
assets/ollama-data/models/blobs/**   filter=lfs diff=lfs merge=lfs -text
