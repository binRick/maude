#!/usr/bin/env bash
#
# Launch OpenCode against the local model.
#
#   MODE=docker (default)  Ollama in container, CPU.
#   MODE=metal             Ollama on host, Metal GPU.
#
# OpenCode runs natively (it's a single static binary) and talks directly
# to Ollama's OpenAI-compat endpoint on :11434/v1 — bypassing LiteLLM,
# which currently has a bug forwarding structured tool_calls from ollama_chat.
# LiteLLM still gets started so other OpenAI clients can use :4000.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"

MODE="${MODE:-docker}"
export MODE

case "$MODE" in
  docker) profiles=docker-backend ;;
  metal)  profiles= ;;
  *) echo "MODE must be 'docker' or 'metal' (got '$MODE')" >&2; exit 1 ;;
esac

if ! command -v opencode >/dev/null; then
  echo "opencode not found in PATH. Install it: brew install anomalyco/tap/opencode" >&2
  exit 1
fi

# Bring backend up if it isn't (idempotent).
(cd "$REPO_ROOT" && COMPOSE_PROFILES="$profiles" docker compose up -d >/dev/null)

# OPENCODE_CONFIG forces this repo's opencode.json regardless of the user's
# CWD. opencode itself runs in $PWD so it can see and edit the user's files.
export OPENCODE_CONFIG="$REPO_ROOT/opencode.json"
exec opencode "$@"
