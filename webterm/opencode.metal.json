{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "maude": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "maude (host Ollama, metal mode)",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B-A3B (host, Metal GPU)",
